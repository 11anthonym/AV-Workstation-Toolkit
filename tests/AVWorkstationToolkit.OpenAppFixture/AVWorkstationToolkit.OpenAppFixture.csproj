<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <AssemblyName>AVWorkstationToolkit.OpenAppFixture</AssemblyName>
    <RootNamespace>AVWorkstationToolkit.OpenAppFixture</RootNamespace>
    <Company>AV Workstation Toolkit Project</Company>
    <Product>AV Workstation Toolkit open-app test fixture</Product>
    <Authors>AV Workstation Toolkit contributors</Authors>
    <Description>Non-shipping desktop app stand-in that the integration harness asks to close through Windows Restart Manager.</Description>
  </PropertyGroup>
</Project>

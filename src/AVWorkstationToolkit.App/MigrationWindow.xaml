<Window x:Class="AVWorkstationToolkit.App.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workstation migration - AV Workstation Toolkit"
        Icon="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.ico"
        Width="1240" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterOwner" Background="#0A0F1C" Foreground="#E8EEF8"
        FontFamily="Segoe UI" FontSize="13" AutomationProperties.Name="Workstation migration and provisioning">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/AVWorkstationToolkit.App;component/WorkstationStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="11,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="FontSize" Value="12"/>
                <Setter Property="Command" Value="{Binding FilterCommand}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0E1728" BorderBrush="#26364F" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel>
                <TextBlock Text="Workstation migration" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Carry applications from an old workstation to a replacement, or set up this PC from a workstation template." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0E1728" BorderBrush="#26364F" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="MigrationSidebar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,12,14">
                    <StackPanel>
                        <TextBlock Text="THIS PC" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="ThisPcTitle" Text="{Binding ThisPcTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ThisPcSummary" Text="{Binding ThisPcSummary}" Foreground="#C5D4E8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ThisPcDetail}" Foreground="#8395AC" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <Button x:Name="ScanButton" Content="Scan this PC" Command="{Binding ScanCommand}" Style="{StaticResource SidebarButton}"
                                ToolTip="Reads Windows installed apps, WinGet identities, and the AVWT catalog. Nothing is changed. (F5)"
                                AutomationProperties.HelpText="Reads Windows installed apps, WinGet identities, and the AVWT catalog. Nothing is changed."/>
                        <Button x:Name="ExportInventoryButton" Content="Export inventory…" Command="{Binding ExportInventoryCommand}" Style="{StaticResource SidebarButton}"
                                ToolTip="Saves every installed application found on this PC to a portable file."
                                AutomationProperties.HelpText="Saves every installed application found on this PC to a portable inventory file."/>
                        <TextBlock Text="On the old PC: scan, then export. Carry the file to the replacement PC." Foreground="#70849D" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="SET UP THIS PC" Style="{StaticResource SectionLabel}" Margin="0,22,0,0"/>
                        <Button x:Name="ImportInventoryButton" Content="Import inventory…" Command="{Binding ImportInventoryCommand}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Margin="0,7,0,0"
                                AutomationProperties.HelpText="Opens an inventory exported on the old PC and compares it with this PC right away."/>
                        <Button x:Name="ApplyProfileButton" Content="Apply workstation template…" Command="{Binding ApplyProfileCommand}" Style="{StaticResource SidebarButton}"
                                AutomationProperties.HelpText="Opens a workstation template and compares it with this PC."/>
                        <TextBlock Text="The checklist compares the imported list with this PC immediately. Nothing installs until you choose it." Foreground="#70849D" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="WORKSTATION TEMPLATES" Style="{StaticResource SectionLabel}" Margin="0,22,0,0"/>
                        <Button x:Name="NewProfileButton" Content="New workstation template…" Command="{Binding NewProfileCommand}" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="EditProfileButton" Content="Revise a workstation template…" Command="{Binding EditProfileCommand}" Style="{StaticResource SidebarButton}"/>
                        <Button x:Name="SaveAsProfileButton" Content="Save checklist as workstation template…" Command="{Binding SaveAsProfileCommand}" Style="{StaticResource SidebarButton}"
                                AutomationProperties.HelpText="Creates a reusable workstation template from the applications selected in this checklist."/>

                        <Border Margin="0,18,0,0" Background="#321719" BorderBrush="#A43F48" BorderThickness="1" CornerRadius="8" Padding="10"
                                Visibility="{Binding SavedSessionProblemVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SavedSessionProblem}" Foreground="#FFB3BA" TextWrapping="Wrap" FontSize="11.5"/>
                                <Button Content="Discard saved checklist" Command="{Binding DiscardSavedCommand}" Style="{StaticResource SidebarButton}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="MigrationStatus" Text="{Binding Status}" Foreground="#8FB9EC" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="11.5"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Migration status"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="160"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SourceTitle" Text="{Binding SourceTitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="RemainingHeadline" Text="{Binding RemainingHeadline}" FontSize="24" FontWeight="SemiBold" Foreground="#F8D27A" Margin="0,8,0,0"
                                   Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.Name="Applications remaining" AutomationProperties.LiveSetting="Polite"/>
                        <Grid Margin="0,6,0,0" Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ProgressBar x:Name="MigrationProgress" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" AutomationProperties.Name="Migration progress"/>
                            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="SummaryText" Text="{Binding SummaryText}" Foreground="#AAB8CA" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="RescanButton" Content="Rescan" Command="{Binding ScanCommand}" Margin="0,0,8,0" ToolTip="Check this PC again, for example after installing an app manually. (F5)"/>
                        <Button x:Name="FinishButton" Content="Finish migration" Command="{Binding FinishCommand}" ToolTip="Ends this migration and deletes its saved checklist."/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#11372D" BorderBrush="#226C57" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding CompleteVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Every selected application is done. Finish the migration when you've completed any manual checks." Foreground="#9FF0D2" TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <TextBox x:Name="ChecklistSearch" DockPanel.Dock="Right" Width="220" Margin="8,0,0,6" VerticalAlignment="Top"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name, publisher, catalog ID, or WinGet ID"
                                     AutomationProperties.Name="Search the migration checklist"/>
                            <WrapPanel x:Name="ChecklistFilters">
                                <Button Content="{Binding RemainingLabel}" CommandParameter="Remaining" AutomationProperties.Name="Show applications still to do"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Remaining"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding ReadyLabel}" CommandParameter="ReadyToInstall" AutomationProperties.Name="Show applications available for automatic installation"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="ReadyToInstall"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding ManualLabel}" CommandParameter="Manual" AutomationProperties.Name="Show applications that need manual installation"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Manual"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding AttentionLabel}" CommandParameter="NeedsAttention" AutomationProperties.Name="Show applications to review, failed installs, and checks that couldn't finish"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="NeedsAttention"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding CompletedLabel}" CommandParameter="Completed" AutomationProperties.Name="Show applications detected as installed"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Completed"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding ExcludedLabel}" CommandParameter="Excluded" AutomationProperties.Name="Show excluded applications"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Excluded"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding SupportingLabel}" CommandParameter="Supporting" AutomationProperties.Name="Show supporting components left out of the migration"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Supporting"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding AllLabel}" CommandParameter="All" AutomationProperties.Name="Show every checklist application"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="All"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </WrapPanel>
                        </DockPanel>
                        <DataGrid x:Name="ChecklistGrid" Grid.Row="1" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}" IsReadOnly="False"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Migration checklist">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" MinWidth="44" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="0"/></Style></DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBox}" IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  ToolTip="Included in this migration. Clear to exclude it; you can include it again later."
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Include {0} in this migration'}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="158" MinWidth="140" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Border Background="{Binding StatusBrush}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" ToolTip="{Binding Detail}">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Application" Width="1.4*" MinWidth="200" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F5FA" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding OptionalLabel}" Foreground="#9FB1C8" FontSize="10.5" Margin="8,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Publisher}" Foreground="#8395AC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Old PC" Binding="{Binding SourceVersion}" Width="96" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                                <DataGridTemplateColumn Header="This PC" Width="112" MinWidth="96" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding InstalledVersion}" Foreground="#C9D5E4" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledVersion}"/>
                                            <TextBlock Text="{Binding VersionNote}" Foreground="#7E9FC7" FontSize="10.5"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Next step" Width="2*" MinWidth="200" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17" Foreground="#C5D4E8" ToolTip="{Binding Detail}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="100" MinWidth="100" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="Install" Style="{StaticResource SuccessButton}" Padding="12,3" MinHeight="28"
                                                Command="{Binding DataContext.InstallItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Install {0}'}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid x:Name="EmptyState" Visibility="{Binding NoSessionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="#0D1524" BorderBrush="#26364F" BorderThickness="1" CornerRadius="9" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="No migration in progress" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#AAB8CA" Margin="0,6,0,0"
                                           Text="On the old PC: review the applications below, clear any you don't want to carry over, and export the inventory. On the replacement PC: import that file. The Toolkit compares it with the replacement right away and lists only what's still needed."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#8395AC" FontSize="11.5" Margin="0,6,0,0"
                                           Text="Setting up a standard workstation instead? Apply a workstation template. An inventory or workstation template only describes what's wanted; the Toolkit installs only apps its approved managed catalog allows, with the same checks as the main window."/>
                            </StackPanel>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,12,0,6" Visibility="{Binding ReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="ReviewSearch" DockPanel.Dock="Right" Width="220" Margin="8,0,0,0" Text="{Binding ReviewSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by name, publisher, or identity" AutomationProperties.Name="Search this PC's applications"/>
                            <CheckBox DockPanel.Dock="Right" Content="Show supporting and system components" IsChecked="{Binding ShowSupportingComponents}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Applications on this PC" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReviewSummary" Text="{Binding ReviewSummary}" Foreground="#8FB9EC" FontSize="11.5"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="ReviewGrid" Grid.Row="2" ItemsSource="{Binding ReviewItems}" IsReadOnly="False" MinRowHeight="40"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="Applications on this PC to include in the exported migration">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Migrate" Width="72" MinWidth="72" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox Style="{StaticResource GridCheckBox}" IsChecked="{Binding Migrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Carry this application to the replacement PC. Cleared items are still recorded in the file but start excluded."
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Migrate {0}'}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Application" Width="1.6*" MinWidth="200" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding Publisher}" Foreground="#8395AC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" MinWidth="90" IsReadOnly="True" CanUserSort="False"/>
                                <DataGridTemplateColumn Header="Identified as" Width="1.2*" MinWidth="160" IsReadOnly="True" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding IdentityLabel}" Foreground="#C5D4E8" TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityLabel}"/>
                                            <TextBlock Text="{Binding RelevanceLabel}" Foreground="#7E9FC7" FontSize="10.5" ToolTip="{Binding RelevanceReason}"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border x:Name="DetailPanel" Grid.Row="3" Margin="0,10,0,0" Background="#101C2D" BorderBrush="#34506F" BorderThickness="1" CornerRadius="8" Padding="12"
                        Visibility="{Binding DetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Selected application details">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Name}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding SelectedItem.Detail}" TextWrapping="Wrap" Foreground="#DDE6F3" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedItem.IdentityText}" TextWrapping="Wrap" Foreground="#8FB9EC" FontSize="11.5" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SelectedItem.EvidenceText, StringFormat='On this PC: {0}'}" TextWrapping="Wrap" Foreground="#8395AC" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="330" Margin="12,0,0,0">
                            <Button x:Name="InstallSelectedButton" Content="Install" Style="{StaticResource SuccessButton}" Command="{Binding InstallSelectedCommand}" Margin="0,0,6,6"/>
                            <Button x:Name="ConfirmButton" Content="Confirm installed" Command="{Binding ConfirmCommand}" Margin="0,0,6,6"
                                    Visibility="{Binding SelectedItem.CanConfirm, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                    ToolTip="Only for an app AV Workstation Toolkit has no way to detect. Every other app leaves the list when a scan detects it."/>
                            <Button x:Name="ClearConfirmationButton" Content="Clear confirmation" Command="{Binding UndoConfirmCommand}" Margin="0,0,6,6"
                                    Visibility="{Binding SelectedItem.IsConfirmed, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <Button x:Name="ExcludeButton" Content="Exclude" Command="{Binding ExcludeCommand}" Margin="0,0,6,6" ToolTip="Leave this app off the migration; you can include it again."/>
                            <Button x:Name="IncludeButton" Content="Include" Command="{Binding IncludeCommand}" Margin="0,0,6,6"/>
                            <Button x:Name="RemoveButton" Content="Remove…" Command="{Binding RemoveCommand}" Margin="0,0,6,6" ToolTip="Remove this app from the migration permanently."/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="TasksPanel" Grid.Row="4" Margin="0,10,0,0" Background="#0D1524" BorderBrush="#26364F" BorderThickness="1" CornerRadius="8" Padding="12,8"
                        Visibility="{Binding TasksVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Manual checks from the workstation template">
                    <StackPanel>
                        <TextBlock Text="{Binding TasksSummary}" FontWeight="SemiBold"/>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <CheckBox Content="{Binding Text}" IsChecked="{Binding Done, Mode=TwoWay}" IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Width="300" Margin="0,2,12,2" AutomationProperties.Name="{Binding Text}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="5" Margin="0,12,0,0" Visibility="{Binding HasSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding AutomaticInstallNote}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <CheckBox x:Name="MigrationRiskAcknowledgement" Content="{Binding RiskAcknowledgementText}" IsChecked="{Binding RiskAcknowledged}" Margin="0,6,0,0"
                                  Visibility="{Binding RiskAcknowledgementVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="Confirm system-impact changes for this installation"/>
                    </StackPanel>
                    <Button x:Name="InstallAllButton" Grid.Column="1" Style="{StaticResource SuccessButton}" Content="{Binding InstallAllText}" Command="{Binding InstallAllCommand}" Margin="12,0,0,0" MinWidth="190"
                            ToolTip="Installs every selected app the approved managed catalog allows, one at a time. Each app is checked again before it starts."/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

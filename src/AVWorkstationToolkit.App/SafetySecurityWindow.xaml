<Window x:Class="AVWorkstationToolkit.App.SafetySecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Safety &amp; Security - AV Workstation Toolkit" Width="680" Height="560" MinWidth="520" MinHeight="400"
        Icon="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.ico"
        WindowStartupLocation="CenterOwner" Background="#0A0F1C" Foreground="#E8EEF8"
        FontFamily="Segoe UI" FontSize="13" AutomationProperties.Name="AV Workstation Toolkit safety and security">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="SafetyHeading" Text="Safety &amp; Security" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="SafetyBody" TextWrapping="Wrap" Foreground="#C7D3E3" LineHeight="21" Padding="2"><Run Text="AV Workstation Toolkit is a local workstation manager. It runs as a standard user and does not expose a local web or command server."/><LineBreak/><LineBreak/><Run Text="Managed actions are limited to exact, approved WinGet package IDs. The independent compiled worker revalidates the live workstation plan before each package and submits one package at a time. An individual installer may request elevation through the normal Windows consent prompt."/><LineBreak/><LineBreak/><Run Text="Catalog-only and manual applications provide read-only knowledge, inventory, or an approved handoff. They never acquire managed worker authority. Downloaded packages must pass their catalogued path, size, hash, signature, and publisher rules before AV Workstation Toolkit can reveal them in File Explorer; it does not execute them."/><LineBreak/><LineBreak/><Run Text="AV Workstation Toolkit does not provide uninstall, rollback, security-management, MDM, VPN, EDR, driver-management, or operating-system management features. Pending Windows restarts continue to block driver-, service-, and listener-bearing changes while ordinary low-risk apps remain available."/><LineBreak/><LineBreak/><Run Text="Authenticated SFTP validates host identity before credential use. Credentials remain isolated in memory or Windows Credential Manager and are excluded from process arguments, logs, diagnostics, and action artifacts."/></TextBlock>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Close" IsDefault="True" IsCancel="True" MinWidth="90" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="16,7" Click="Close_Click"/>
    </Grid>
</Window>

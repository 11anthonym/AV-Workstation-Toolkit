<Window x:Class="AVWorkstationToolkit.App.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.ico"
        Width="980" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#0A0F1C" Foreground="#E8EEF8"
        FontFamily="Segoe UI" FontSize="13" AutomationProperties.Name="Deployment profile editor">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/AVWorkstationToolkit.App;component/WorkstationStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,14"
                       Text="A deployment profile describes what a type of workstation should have, such as a jump PC or a commissioning laptop. It is separate from the Standard, Field, Developer, and Optional catalog profiles. Applying it builds the same checklist as a migration. It never lets the Toolkit install anything the approved managed catalog doesn't allow."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Deployment profile name" Foreground="#B9C8DB" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="ProfileName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Deployment profile name"/>
                <TextBlock Text="{Binding ProfileIdText}" Foreground="#70849D" FontSize="10.5" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Version" Foreground="#B9C8DB" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="ProfileVersion" Text="{Binding VersionText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Deployment profile version"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Description" Foreground="#B9C8DB" FontSize="11" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Deployment profile description"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,14,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Right" Content="Selected only" IsChecked="{Binding ShowSelectedOnly}" Margin="10,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}" Foreground="#8FB9EC" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="ProfileSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search catalog applications"
                             AutomationProperties.Name="Search catalog applications for the profile"/>
                </DockPanel>
                <DataGrid x:Name="ProfileApplications" Grid.Row="1" ItemsSource="{Binding VisibleApplications}" IsReadOnly="False" MinRowHeight="38"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="Applications in this deployment profile">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Include" Width="64" IsReadOnly="True" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox Style="{StaticResource GridCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Include {0} in the deployment profile'}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Application" Width="2*" IsReadOnly="True" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Vendor}" Foreground="#8395AC" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="How it's installed" Binding="{Binding Kind}" Width="1.3*" IsReadOnly="True" CanUserSort="False"/>
                        <DataGridTemplateColumn Header="Required" Width="80" IsReadOnly="True" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox Style="{StaticResource GridCheckBox}" IsChecked="{Binding Required, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selected}"
                                          ToolTip="Optional applications start excluded when the profile is applied."
                                          AutomationProperties.Name="{Binding Name, StringFormat='{}{0} is required'}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="An application that isn't in the catalog"
                             AutomationProperties.Name="Name of an application that isn't in the catalog"/>
                    <TextBox Grid.Column="1" Text="{Binding CustomPublisher, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" ToolTip="Publisher (optional)"
                             AutomationProperties.Name="Publisher of that application"/>
                    <Button Grid.Column="2" Content="Add app not in catalog" Command="{Binding AddCustomCommand}"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Manual checks" FontWeight="SemiBold"/>
                    <TextBlock Text="One per line, such as 'Verify remote connectivity'. These are reminders for the technician; the Toolkit never runs them." Foreground="#8395AC" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,6"/>
                </StackPanel>
                <TextBox x:Name="ProfileChecks" Grid.Row="1" Text="{Binding ChecksText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Manual checks, one per line"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="#FFB3BA" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="8,0,0,0"/>
                <Button x:Name="SaveProfileButton" Content="Save…" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="110"/>
                <Button x:Name="SaveAndApplyButton" Content="Save and apply to this PC…" Command="{Binding SaveAndApplyCommand}" Style="{StaticResource SuccessButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

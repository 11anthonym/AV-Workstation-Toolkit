<Window x:Class="AVWorkstationToolkit.App.ManagedCatalogUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Managed app catalog updates" Width="620" Height="480" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#0A0F1C" Foreground="#E8EEF8"
        Icon="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.ico"
        AutomationProperties.Name="Managed app catalog updates">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#1D2A40"/><Setter Property="BorderBrush" Value="#344663"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Managed app catalog updates" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,18" Foreground="#AAB8CA" TextWrapping="Wrap" Text="Update the signed list of WinGet apps and reviewed installation policies. The worker verifies the same catalog independently before any action."/>
        <Border Grid.Row="2" Background="#101C2D" BorderBrush="#34506F" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{Binding Status.Detail}" Foreground="#AAB8CA" Margin="0,5,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="Effective revision" Foreground="#7F92AA" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding CurrentLabel}" Margin="0,2,0,8"/>
                <TextBlock Text="Catalog source" Foreground="#7F92AA" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding SourceLabel}" Margin="0,2,0,8"/>
                <TextBlock Text="Update ready" Foreground="#7F92AA" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding AvailableLabel}" Margin="0,2,0,8"/>
                <TextBlock Text="{Binding VerificationLabel}" Foreground="#C5D4E8"/>
                <TextBlock Text="{Binding RestartLabel}" Foreground="#F3C969" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Foreground="#94A4BB" TextWrapping="Wrap" Text="A rejected or unavailable update never replaces the signed baseline or currently verified catalog. Downloaded changes take effect only after restart so the application and worker select one revision."/>
        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Check now" Command="{Binding CheckNowCommand}" AutomationProperties.Name="Check for managed app catalog updates"/>
            <Button Content="Download update" Command="{Binding InstallCommand}" AutomationProperties.Name="Download and save the verified managed app catalog update"/>
            <Button Content="Close" IsCancel="True" Margin="0"/>
        </WrapPanel>
    </Grid>
</Window>

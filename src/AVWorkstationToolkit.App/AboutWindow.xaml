<Window x:Class="AVWorkstationToolkit.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AV Workstation Toolkit" Width="480" Height="350" MinWidth="420" MinHeight="320"
        Icon="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.ico"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0A0F1C" Foreground="#E8EEF8"
        FontFamily="Segoe UI" FontSize="13" AutomationProperties.Name="About AV Workstation Toolkit">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
            <Image x:Name="BrandMark" Width="64" Height="64" Source="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.png" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="AV Workstation Toolkit application mark"/>
            <TextBlock x:Name="ProductTitle" Text="AV Workstation Toolkit" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="IdentityText" Foreground="#8FB9EC" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock x:Name="DescriptionText" Text="Local commercial-AV workstation management, inventory, catalog knowledge, and diagnostics." Foreground="#B8C6D8" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,18,0,0"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Close" IsDefault="True" IsCancel="True" MinWidth="90" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="16,7" Click="Close_Click"/>
    </Grid>
</Window>

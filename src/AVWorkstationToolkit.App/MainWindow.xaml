<Window x:Class="AVWorkstationToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AV Workstation Toolkit 1.1.1 — Compiled migration preview"
        Width="1280" Height="860" MinWidth="1040" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#0A0F1C" Foreground="#E8EEF8"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A4BB"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#1D2A40"/>
            <Setter Property="BorderBrush" Value="#344663"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#293A55"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#69A6FF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#147D64"/><Setter Property="BorderBrush" Value="#2DBD97"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#0C1423"/><Setter Property="BorderBrush" Value="#30415D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="TextBoxChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#69A6FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxChrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="QuickViewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#0C1423"/><Setter Property="BorderBrush" Value="#30415D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                <ContentPresenter Margin="10,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False"/>
                <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#9FB1C8" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"><Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Margin="0,3,0,0" Background="#111D2E" BorderBrush="#3A4C68" BorderThickness="1" CornerRadius="5"><ScrollViewer Margin="2" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="#111D2E"/><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#49617F"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#69A6FF"/></Trigger>
                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#69A6FF"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Opacity" Value="0.45"/><Setter Property="Foreground" Value="#718198"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#111D2E"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#243A59"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#1D4D83"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemChrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE6F3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,5"/><Setter Property="MinHeight" Value="24"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckChrome" Width="17" Height="17" Background="#0C1423" BorderBrush="#526783" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center"/><Path x:Name="CheckMark" Data="M 3 7 L 6 10 L 12 4" Stroke="#FFFFFF" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="#2563EB"/><Setter TargetName="CheckChrome" Property="BorderBrush" Value="#69A6FF"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckChrome" Property="BorderBrush" Value="#8AB7F4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckChrome" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GridSelectionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="40"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style>
        <Style TargetType="Menu"><Setter Property="Background" Value="#0B1322"/><Setter Property="Foreground" Value="#DDE6F3"/><Setter Property="BorderBrush" Value="#26364F"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
        <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#DDE6F3"/><Setter Property="Background" Value="#0B1322"/><Setter Property="Padding" Value="11,5"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#243A59"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#718198"/><Setter Property="Opacity" Value="0.7"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#0D1524"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="BorderBrush" Value="#26364F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#1B2A40"/><Setter Property="RowBackground" Value="#0D1524"/><Setter Property="AlternatingRowBackground" Value="#101A2A"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="MinRowHeight" Value="58"/><Setter Property="ColumnHeaderHeight" Value="38"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#152137"/><Setter Property="Foreground" Value="#AFC0D6"/><Setter Property="BorderBrush" Value="#26364F"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#E8EEF8"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C3150"/><Setter Property="Foreground" Value="#F1F5FA"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#18263B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C3150"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="92"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Menu x:Name="TopMenu" Grid.Row="0" AutomationProperties.Name="Application menu">
            <MenuItem Header="_File"><MenuItem Header="_Export plan..." IsEnabled="False"/><MenuItem Header="Open _logs" IsEnabled="False"/><Separator/><MenuItem Header="E_xit" Command="{Binding ExitCommand}"/></MenuItem>
            <MenuItem Header="_View"><MenuItem Header="_Refresh plan" InputGestureText="F5" Command="{Binding RefreshCommand}"/><MenuItem Header="_Diagnostics" Command="{Binding DiagnosticsCommand}"/></MenuItem>
            <MenuItem Header="_Tools"><MenuItem Header="_Check system state" Command="{Binding RefreshCommand}"/></MenuItem>
            <MenuItem Header="_Help"><MenuItem Header="_Safety &amp; Security" IsEnabled="False"/><MenuItem Header="_About AV Workstation Toolkit" IsEnabled="False"/></MenuItem>
        </Menu>
        <Border Grid.Row="1" Background="#0E1728" BorderBrush="#26364F" BorderThickness="0,0,0,1"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="12" Background="#2563EB" VerticalAlignment="Center"><TextBlock Text="AV" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="AV Workstation Toolkit" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="AV/IT workstation setup and maintenance — compiled read-only migration" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
        <Border x:Name="RebootBanner" Grid.Row="2" Background="#3A2B0B" BorderBrush="#8A6513" BorderThickness="0,0,0,1" Padding="24,12" Visibility="{Binding WarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><DockPanel><Button DockPanel.Dock="Right" Content="Check again" Command="{Binding RefreshCommand}" Padding="12,4" MinHeight="28" Margin="12,0,0,0" AutomationProperties.Name="Check reboot and inventory state again"/><TextBlock Text="!" FontWeight="Bold" FontSize="17" Foreground="#F8C555" Margin="0,0,12,0"/><TextBlock Text="{Binding WarningText}" Foreground="#FFE4A3" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0E1728" BorderBrush="#26364F" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,10,14"><StackPanel>
                <TextBlock Text="FIND APPS" Foreground="#7F92AA" FontSize="10" FontWeight="Bold"/><TextBox x:Name="SearchBox" Margin="0,7,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by application name, package ID, vendor, or purpose" AutomationProperties.Name="Search applications"/>
                <StackPanel Margin="0,14,0,0"><TextBlock Text="PROFILES" Foreground="#7F92AA" FontSize="10" FontWeight="Bold"/><WrapPanel Margin="0,3,0,0"><CheckBox x:Name="StandardFilter" Content="Standard" IsChecked="{Binding StandardProfile}" Width="116"/><CheckBox Content="Field" IsChecked="{Binding FieldProfile}" Width="104"/><CheckBox Content="Developer" IsChecked="{Binding DeveloperProfile}" Width="116"/><CheckBox Content="Optional" IsChecked="{Binding OptionalProfile}" Width="104"/></WrapPanel></StackPanel>
                <Border Margin="0,14,0,0" Background="#101C2D" BorderBrush="#26364F" BorderThickness="1" CornerRadius="8" Padding="11"><StackPanel><TextBlock Text="CATALOG VIEW" Foreground="#8EA2BB" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Catalog" Foreground="#B9C8DB" FontSize="11" Margin="0,8,0,3"/><ComboBox x:Name="CatalogPresetFilter" ItemsSource="{Binding CatalogPresetOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedCatalogPreset}" AutomationProperties.Name="Catalog policy filter"/>
                    <TextBlock Text="Priority" Foreground="#B9C8DB" FontSize="11" Margin="0,7,0,3"/><ComboBox ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPriority}" AutomationProperties.Name="Priority filter"/>
                    <TextBlock Text="Manufacturer" Foreground="#B9C8DB" FontSize="11" Margin="0,7,0,3"/><ComboBox x:Name="ManufacturerFilter" ItemsSource="{Binding ManufacturerOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedManufacturer}" AutomationProperties.Name="Manufacturer filter"/>
                    <TextBlock Text="Discipline" Foreground="#B9C8DB" FontSize="11" Margin="0,7,0,3"/><ComboBox x:Name="DisciplineFilter" ItemsSource="{Binding DisciplineOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDiscipline}" AutomationProperties.Name="AV discipline filter"/>
                    <TextBlock Text="Role" Foreground="#B9C8DB" FontSize="11" Margin="0,7,0,3"/><ComboBox x:Name="RoleFilter" ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRole}" AutomationProperties.Name="AV role filter"/>
                </StackPanel></Border>
                <StackPanel Margin="0,14,0,0"><TextBlock Text="QUICK VIEWS" Foreground="#7F92AA" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding QuickViewText}" Foreground="#8FB9EC" FontSize="11" Margin="0,7,0,0"/>
                    <Button x:Name="AllAppsButton" Content="All apps" Command="{Binding QuickViewCommand}" CommandParameter="All" Margin="0,7,0,0" AutomationProperties.Name="Show all applications"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickViewButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAllQuickView}" Value="True"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button x:Name="SelectMissingButton" Content="Missing apps" Command="{Binding QuickViewCommand}" CommandParameter="Missing" Margin="0,7,0,0" AutomationProperties.Name="Show missing applications and select eligible installs"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickViewButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMissingQuickView}" Value="True"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button x:Name="SelectUpdatesButton" Content="Available updates" Command="{Binding QuickViewCommand}" CommandParameter="Updates" Margin="0,7,0,0" AutomationProperties.Name="Show available updates and select eligible updates"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickViewButton}"><Style.Triggers><DataTrigger Binding="{Binding IsUpdatesQuickView}" Value="True"><Setter Property="Background" Value="#1D4D83"/><Setter Property="BorderBrush" Value="#69A6FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <TextBlock Text="SELECTION" Foreground="#7F92AA" FontSize="10" FontWeight="Bold" Margin="0,13,0,0"/><Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,7,0,0" AutomationProperties.Name="Clear selected application actions"/>
                </StackPanel>
                <StackPanel Margin="0,14,0,0"><TextBlock Text="CURRENT PLAN" Foreground="#7F92AA" FontSize="10" FontWeight="Bold"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#111F32" CornerRadius="8" Padding="10" Margin="0,0,5,0"><StackPanel><TextBlock Text="{Binding CurrentCount}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Current" Foreground="#8395AC" FontSize="11"/></StackPanel></Border><Border Grid.Column="1" Background="#111F32" CornerRadius="8" Padding="10" Margin="5,0,0,0"><StackPanel><TextBlock Text="{Binding ActionCount}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Actionable" Foreground="#8395AC" FontSize="11"/></StackPanel></Border></Grid></StackPanel>
            </StackPanel></ScrollViewer></Border>
            <Grid Grid.Column="1" Margin="18,14,18,16"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*" MinHeight="180"/><RowDefinition Height="160" MinHeight="120"/><RowDefinition Height="Auto" MinHeight="56"/></Grid.RowDefinitions>
                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Applications" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="View details" Command="{Binding DetailsCommand}" Margin="0,0,8,0" AutomationProperties.Name="View selected application details"/><Button Content="Diagnostics" Command="{Binding DiagnosticsCommand}" Margin="0,0,8,0" AutomationProperties.Name="View compiled migration diagnostics"/><Button x:Name="RefreshButton" Content="Refresh plan" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh application plan"/></StackPanel></Grid>
                <DataGrid x:Name="PackageGrid" Grid.Row="1" Margin="0,4,0,14" ItemsSource="{Binding VisiblePackages}" SelectedItem="{Binding SelectedRow}" IsReadOnly="False" Sorting="PackageGrid_Sorting" SizeChanged="PackageGrid_SizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Application selection table"><DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" MinWidth="44" IsReadOnly="True" CanUserSort="False"><DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="0"/></Style></DataGridTemplateColumn.CellStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource GridSelectionCheckBox}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SelectionEnabled}" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Select application" AutomationProperties.HelpText="{Binding SelectionHint}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Application" SortMemberPath="ApplicationSortKey" Width="1.5*" MinWidth="190" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F5FA" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Id}" Foreground="#70849D" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Vendor" SortMemberPath="VendorSortKey" Width="0.9*" MinWidth="95" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Vendor}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Priority" SortMemberPath="PrioritySortKey" Binding="{Binding Priority}" Width="68" MinWidth="68" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Status" SortMemberPath="StatusSortKey" Width="150" MinWidth="135" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StatusBrush}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" ToolTip="{Binding StatusDetail}"><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Versions" SortMemberPath="VersionSortKey" Width="110" MinWidth="110" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding VersionLabel}" Foreground="#C9D5E4" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionLabel}"/><TextBlock Text="{Binding AvailableLabel}" Foreground="#7E9FC7" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding AvailableLabel}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Risk" SortMemberPath="RiskSortKey" Width="65" MinWidth="65" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskForeground}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding RiskLabel}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Purpose / restriction" Width="2*" MinWidth="220" IsReadOnly="True" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Note}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17" MaxHeight="36" ToolTip="{Binding Note}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns></DataGrid>
                <Border Grid.Row="2" Background="#0D1524" BorderBrush="#26364F" BorderThickness="1" CornerRadius="9" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Activity" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ActivityState}" Foreground="#8092A9"/></Grid><TextBox x:Name="ActivityLog" Grid.Row="1" Text="{Binding ActivityText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#080E19" AutomationProperties.Name="Application activity log"/></Grid></Border>
                <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding ActionProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#3B82F6" Background="#18243A"/><TextBlock x:Name="SelectionSummary" Text="{Binding SelectionSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><TextBlock Text="LIVE DEVELOPER REHEARSAL — selected managed actions can change this workstation" Foreground="#F8C55C" FontWeight="SemiBold" Visibility="{Binding LiveRehearsalMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" AutomationProperties.Name="Live developer rehearsal warning"/><CheckBox Content="Acknowledge selected driver/service/listener risk" IsChecked="{Binding RiskAcknowledged}" Visibility="{Binding MigrationActionMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0" AutomationProperties.Name="Acknowledge risk for this migration test run"/></StackPanel><WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Content="Get package" Margin="8,4,0,4" IsEnabled="False" ToolTip="Vendor interaction is available only from validated application details in explicit migration mode."/><Button Content="Cancel action" Command="{Binding CancelActionCommand}" Margin="8,4,0,4" Visibility="{Binding MigrationActionMode, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Records cooperative cancellation intent; it does not terminate the worker."/><Button x:Name="InstallButton" Style="{StaticResource SuccessButton}" Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" Margin="8,4,0,4" ToolTip="Normal compiled preview is read-only. The explicit live developer rehearsal mode can run an exact authorized action."/><Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}" Margin="8,4,0,4" ToolTip="Normal compiled preview is read-only. The explicit live developer rehearsal mode can run an exact authorized action."/></WrapPanel></Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

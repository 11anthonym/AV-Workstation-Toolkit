<Window x:Class="AVWorkstationToolkit.App.CatalogUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device catalog updates" Width="620" Height="460" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#0A0F1C" Foreground="#E8EEF8"
        Icon="/AVWorkstationToolkit.App;component/Assets/AVWorkstationToolkit.ico"
        AutomationProperties.Name="Device catalog updates">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#1D2A40"/><Setter Property="BorderBrush" Value="#344663"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Device catalog updates" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,18" Foreground="#AAB8CA" TextWrapping="Wrap" Text="Update the device and software-reference information used by Device Lookup. This doesn't update installed apps, and your saved catalog works offline."/>
        <Border Grid.Row="2" Background="#101C2D" BorderBrush="#34506F" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{Binding DetailLabel}" Foreground="#AAB8CA" Margin="0,5,0,5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding TechnicalDetail}" Foreground="#7F92AA" FontSize="10.5" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="Selected for next launch" Foreground="#7F92AA" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding CurrentLabel}" Margin="0,2,0,8"/>
                <TextBlock Text="Update ready" Foreground="#7F92AA" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding AvailableLabel}" Margin="0,2,0,8"/>
                <TextBlock Text="{Binding ChangeSummary}" TextWrapping="Wrap" Foreground="#C5D4E8"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Foreground="#94A4BB" TextWrapping="Wrap" Text="Downloaded catalogs are checked before they are saved. If a catalog can't be verified, your current catalog stays in use. Restart AV Workstation Toolkit to use a newly saved catalog."/>
        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CheckNowButton" Content="Check now" Command="{Binding CheckNowCommand}" AutomationProperties.Name="Check for device catalog updates"/>
            <Button x:Name="UpdateCatalogButton" Content="Download update" Command="{Binding InstallCommand}" AutomationProperties.Name="Download and save the verified device catalog update"/>
            <Button Content="Close" IsCancel="True" Margin="0"/>
        </WrapPanel>
    </Grid>
</Window>

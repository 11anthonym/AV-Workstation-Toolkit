<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>..\..\assets\branding\AVWorkstationToolkit.ico</ApplicationIcon>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AVWorkstationToolkit</AssemblyName>
    <RootNamespace>AVWorkstationToolkit.Launcher</RootNamespace>
    <Title>AV Workstation Toolkit</Title>
    <AssemblyTitle>AV Workstation Toolkit</AssemblyTitle>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <Company>AV Workstation Toolkit Project</Company>
    <Product>AV Workstation Toolkit</Product>
    <Authors>AV Workstation Toolkit contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Windows application for planning, installing, and maintaining a controlled AV/IT workstation software baseline.</Description>
    <Copyright>Copyright © AV Workstation Toolkit contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <DotNetRuntimeNoticeRoot Condition="'$(DotNetRuntimeNoticeRoot)' == ''">$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64\$(RuntimeFrameworkVersion)</DotNetRuntimeNoticeRoot>
    <ReferenceCatalogBaselinePath Condition="'$(ReferenceCatalogBaselinePath)' == '' and Exists('..\..\catalog\reference\AVWT-Reference-Catalog.avwtcatalog')">..\..\catalog\reference\AVWT-Reference-Catalog.avwtcatalog</ReferenceCatalogBaselinePath>
    <ManagedCatalogBaselinePath Condition="'$(ManagedCatalogBaselinePath)' == '' and Exists('..\..\catalog\managed\AVWT-Managed-Catalog.avwtmanaged')">..\..\catalog\managed\AVWT-Managed-Catalog.avwtmanaged</ManagedCatalogBaselinePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- These AdditionalProperties build App in a second, dependency-file-free flavour into the same
         output path. That is why this project is deliberately NOT in AVWorkstationToolkit.slnx: a
         solution build would race this flavour against the plain App build that the test projects
         reference, and their copy step would fail on the missing App.deps.json/runtimeconfig.json.
         The launcher is built and verified by build\Build-Release.ps1 and tests\Test-Package.ps1. -->
    <ProjectReference Include="..\AVWorkstationToolkit.App\AVWorkstationToolkit.App.csproj"
                      AdditionalProperties="GenerateRuntimeConfigurationFiles=false;GenerateDependencyFile=false;SelfContained=false;PublishSingleFile=false" />
  </ItemGroup>

  <ItemGroup>
    <!-- process-launch-policy.json and winget-team-baseline.json are reviewed repository inputs, not
         runtime inputs: no shipping code parses either one, so they are not embedded or extracted. -->
    <EmbeddedResource Include="..\..\manifests\*.json"
                      Exclude="..\..\manifests\process-launch-policy.json;..\..\manifests\winget-team-baseline.json">
      <LogicalName>AVWorkstationToolkit.Payload.manifests/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md">
      <LogicalName>AVWorkstationToolkit.Payload.notices/THIRD-PARTY-NOTICES.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\LICENSE">
      <LogicalName>AVWorkstationToolkit.Payload.notices/PROJECT-LICENSE.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(WorkerPayloadPath)" Condition="'$(WorkerPayloadPath)' != '' and Exists('$(WorkerPayloadPath)')">
      <LogicalName>AVWorkstationToolkit.Payload.worker/AVWorkstationToolkit.Worker.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(ReferenceCatalogBaselinePath)" Condition="'$(ReferenceCatalogBaselinePath)' != '' and Exists('$(ReferenceCatalogBaselinePath)')">
      <LogicalName>AVWorkstationToolkit.Payload.reference-catalog/AVWT-Reference-Catalog.avwtcatalog</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(ManagedCatalogBaselinePath)" Condition="'$(ManagedCatalogBaselinePath)' != '' and Exists('$(ManagedCatalogBaselinePath)')">
      <LogicalName>AVWorkstationToolkit.Payload.managed-catalog/AVWT-Managed-Catalog.avwtmanaged</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(DotNetRuntimeNoticeRoot)\LICENSE.TXT">
      <LogicalName>AVWorkstationToolkit.Payload.notices/DOTNET-LICENSE.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(DotNetRuntimeNoticeRoot)\THIRD-PARTY-NOTICES.TXT">
      <LogicalName>AVWorkstationToolkit.Payload.notices/DOTNET-THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Renci.SshNet" />
  </ItemGroup>

  <Target Name="ValidateThirdPartyNoticeInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DotNetRuntimeNoticeRoot)\LICENSE.TXT')" Text="The .NET $(RuntimeFrameworkVersion) runtime license file is unavailable. Restore the locked release dependencies before building." />
    <Error Condition="!Exists('$(DotNetRuntimeNoticeRoot)\THIRD-PARTY-NOTICES.TXT')" Text="The .NET $(RuntimeFrameworkVersion) third-party notice file is unavailable. Restore the locked release dependencies before building." />
    <Error Condition="'$(WorkerPayloadPath)' != '' and !Exists('$(WorkerPayloadPath)')" Text="The reviewed compiled worker payload is unavailable." />
    <Error Condition="'$(ReferenceCatalogBaselinePath)' != '' and !Exists('$(ReferenceCatalogBaselinePath)')" Text="The signed embedded reference-catalog baseline is unavailable." />
    <Error Condition="'$(ManagedCatalogBaselinePath)' != '' and !Exists('$(ManagedCatalogBaselinePath)')" Text="The signed embedded managed-catalog baseline is unavailable." />
  </Target>
</Project>
